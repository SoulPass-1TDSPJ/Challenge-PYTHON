    return True

# --- AJUSTE NO CARTÃO DIGITAL ---
def gerar_cartao_visual(nome, contato, cpf, id_usuario):
    cargo = "Usuário SoulUP" # Variável que estava faltando
    qr = qrcode.QRCode(version=1, box_size=3, border=1)
    qr.add_data(id_usuario)
    qr.make(fit=True)
    img_qr = qr.make_image(fill_color="white", back_color="black").convert("RGBA")

    card = Image.new('RGB', (800, 400), color = (30, 30, 30)) # Criando a imagem base
    draw = ImageDraw.Draw(card) # Criando o objeto de desenho

    try: 
        font_nome = ImageFont.truetype("arial.ttf", 40)
        font_sub = ImageFont.truetype("arial.ttf", 22)
    except:
        font_nome = ImageFont.load_default()
        font_sub = ImageFont.load_default()
        
    draw.text((60, 100), nome, fill="#FFFFFF", font=font_nome)
    draw.text((60, 160), cargo, fill="#4CAF50", font=font_sub) 
    draw.text((60, 240), f"CPF: {cpf}", fill="#BBBBBB", font=font_sub)
    draw.text((60, 280), contato, fill="#BBBBBB", font=font_sub)

    img_qr = img_qr.resize((150, 150))
    card.paste(img_qr, (550, 100), img_qr)
    card.save(f"cartao_{id_usuario}.png")

# --- AJUSTE NA FUNÇÃO DE SALVAR ---
def salvar_qrcode_json(nome_usuario, cpf, qr_code_str):
    try:
        with open(ARQUIVO_QRCODES, "r", encoding="utf-8") as arquivo:
            dados = json.load(arquivo)
    except:
        dados = []
    
    novo_qrcode = {"nome": nome_usuario, "cpf": cpf, "qrcode": qr_code_str}
    dados.append(novo_qrcode)
    
    with open(ARQUIVO_QRCODES, "w", encoding="utf-8") as arquivo:
        json.dump(dados, arquivo, indent=4, ensure_ascii=False)

